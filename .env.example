# Optional: office WhatsApp number shown to riders after they register (e.g. 9715XXXXXXXX)
VITE_OFFICE_WHATSAPP=
# Optional: WhatsApp community invite link (https://chat.whatsapp.com/XXXX).
# Shown as a "Join the group" button after a rider registers or checks in.
VITE_COMMUNITY_LINK=

# Optional: office bank account, shown to riders who want to transfer.
# Never commit real values — set them in the hosting provider's environment.
# The IBAN is checked (mod-97) before it is ever shown to a rider.
VITE_BANK_NAME=
VITE_BANK_ACCOUNT_NAME=
VITE_BANK_IBAN=
VITE_BANK_ACCOUNT_NUMBER=
VITE_BANK_SWIFT=
